# База данных (по умолчанию — локальный SQLite, для продакшена — PostgreSQL)
DATABASE_URL=sqlite:///./finmodel.db

# --- Языковая модель (необязательно: без неё работают движки правил) --------
# Провайдер: anthropic | openai | none. Пусто — автоопределение по ключам.
# LLM_PROVIDER=anthropic

# Вариант 1. Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Вариант 2. Любой OpenAI-совместимый сервис — OpenAI, OpenRouter, DeepSeek,
# Together, Groq, Mistral. Задайте провайдер, ключ, модель и базовый URL:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=anthropic/claude-3.5-sonnet
#   DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
#   Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1
#
# Вариант 3. Локальная модель (ключ не нужен, данные не покидают контур):
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1   # Ollama
# LLM_MODEL=qwen2.5:14b
#
# Вариант 4. Полностью без ИИ: LLM_PROVIDER=none

# Порог уверенности: ниже порога операция помечается «требует подтверждения»
AI_CONFIDENCE_THRESHOLD=0.8

# Лимиты загрузки файлов
MAX_UPLOAD_MB=15
MAX_STATEMENT_ROWS=20000
MAX_INTAKE_FILES=10

# Автоинициализация схемы БД при старте (1 — локально по умолчанию; на Vercel — 0,
# там миграции применяются отдельно: alembic upgrade head)
# DB_AUTO_INIT=1

# CORS: разрешённые origin через запятую (по умолчанию * — для MVP/демо)
# CORS_ORIGINS=https://app.example.com,https://example.com
