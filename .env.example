# База данных (по умолчанию — локальный SQLite, для продакшена — PostgreSQL)
DATABASE_URL=sqlite:///./finmodel.db

# Ключ API для ИИ-категоризации (необязательно: без ключа работают правила и ключевые слова)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Порог уверенности: ниже порога операция помечается «требует подтверждения»
AI_CONFIDENCE_THRESHOLD=0.8

# Лимиты загрузки файлов
MAX_UPLOAD_MB=15
MAX_STATEMENT_ROWS=20000
MAX_INTAKE_FILES=10

# Автоинициализация схемы БД при старте (1 — локально по умолчанию; на Vercel — 0,
# там миграции применяются отдельно: alembic upgrade head)
# DB_AUTO_INIT=1

# CORS: разрешённые origin через запятую (по умолчанию * — для MVP/демо)
# CORS_ORIGINS=https://app.example.com,https://example.com
