# База данных (по умолчанию — локальный SQLite, для продакшена — PostgreSQL)
DATABASE_URL=sqlite:///./finmodel.db

# Ключ API для ИИ-категоризации (необязательно: без ключа работают правила и ключевые слова)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Порог уверенности: ниже порога операция помечается «требует подтверждения»
AI_CONFIDENCE_THRESHOLD=0.8

# Google Sheets (двусторонняя синхронизация модели, необязательно).
# Создайте OAuth-клиент «Web application» в Google Cloud, включите Sheets API и
# Drive API, добавьте redirect URI ниже. Без ключей интеграция выключена.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
