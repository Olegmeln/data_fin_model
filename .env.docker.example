# Переменные для docker-compose (НЕ для backend/.env — это отдельный файл, см. .env.example).
# Скопируйте: cp .env.docker.example .env.docker, заполните и не коммитьте .env.docker в git.

# Пароль для сервисного Postgres-контейнера (сам Postgres поднимается контейнером,
# отдельно арендовать/настраивать не нужно — Neon из README нужен только для варианта Vercel).
POSTGRES_PASSWORD=change_me_to_something_random

# ИИ-категоризация (опционально — без ключа работают правила и ключевые слова)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

AI_CONFIDENCE_THRESHOLD=0.8
MAX_UPLOAD_MB=15
MAX_STATEMENT_ROWS=20000
MAX_INTAKE_FILES=10

# На проде укажите домен, чтобы браузер не ругался на CORS с другого origin
CORS_ORIGINS=https://dfinmodel.online

# Домен для Caddy (используется только с docker compose --profile domain)
DOMAIN=dfinmodel.online
