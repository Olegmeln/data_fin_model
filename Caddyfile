# Reverse-proxy с автоматическим TLS (Let's Encrypt) для dfinmodel.online.
# Активируется только вместе с профилем "domain" в docker-compose.yml —
# нужен сервер с открытыми портами 80/443 и A-записью домена на его IP.

{$DOMAIN} {
	reverse_proxy app:8000
	encode gzip

	# Разумные значения по умолчанию — не обязательны, можно убрать.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}
}
